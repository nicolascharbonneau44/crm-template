generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PersonCategory {
  lead
  prospect
  client
  ex_clients
  autres
}

enum PersonState {
  a_traiter
  a_rappeler
  relance_3mois
  inscription_site
  inscription_newsletter_inscrite
  new_lead
  lead_en_cours
  free_trial
  onboarding
  rdv_a_planifier
  rdv_decouverte
  rencontre
  rdv2_planifie
  relance_suite_rdv
  propale
  done
  kickoff
  perdu
  concurrent
  ok_plus_tard
  mis_de_cote
  pas_de_besoin
  pas_interesse
  prospect_pas_interlocuteur
  plus_dans_societe
  mauvaise_cible
  nok
  erreur_email
  waitlist
  erreur_invitation_linkedin
  autres
}

enum ActionChannel {
  email
  linkedin
  phone
  meeting
  note
  other
}

enum ActionStatut {
  a_faire
  en_cours
  termine
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  role         String   @default("admin")
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  passwordResets PasswordResetToken[]
  actions      Action[]
  stateChanges ContactStateHistory[]
  mcpCodes       McpAuthCode[]
  mcpConnections McpConnection[]
}

model Company {
  id           String    @id @default(cuid())
  nom          String
  email        String?
  telephone    String?
  adresse      String?
  siteWeb      String?
  siret        String?
  codeNaf      String?
  effectif     Int?
  linkedinUrl  String?
  description  String?
  notes        String?
  customFields String    @default("{}")
  contacts     Contact[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Contact {
  id                    String         @id @default(cuid())
  civilite              String?
  prenom                String         @default("")
  nom                   String         @default("")
  email                 String?
  telephone             String?
  poste                 String?
  linkedinUrl           String?
  description           String?
  adresse               String?
  pays                  String?
  source                String?
  category              PersonCategory @default(lead)
  state                 PersonState    @default(new_lead)
  companyId             String?
  company               Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  prochaineActionTitre  String?
  prochaineActionDate   DateTime?
  customFields          String         @default("{}")
  actions               Action[]
  stateHistory          ContactStateHistory[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([category])
  @@index([state])
  @@index([companyId])
  @@index([nom])
  @@index([prenom])
  @@index([prochaineActionDate])
}

model ContactStateHistory {
  id               String          @id @default(cuid())
  contactId        String
  contact          Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  previousState    PersonState?
  newState         PersonState
  previousCategory PersonCategory?
  newCategory      PersonCategory?
  changedById      String?
  changedBy        User?           @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime        @default(now())

  @@index([contactId, createdAt])
}

model Action {
  id              String        @id @default(cuid())
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel         ActionChannel
  titre           String
  contenu         String        @default("")
  statut          ActionStatut  @default(a_faire)
  datePrevue      DateTime?
  dateRealisation DateTime?
  customFields    String        @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([contactId])
  @@index([statut])
  @@index([channel])
  @@index([datePrevue])
}

model SavedView {
  id        String   @id @default(cuid())
  name      String
  entity    String
  viewType  String   @default("list")
  filters   String   @default("{}")
  userId    String?
  isShared  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entity])
  @@index([userId])
}

model CustomColumn {
  id         String   @id @default(cuid())
  entityType String
  key        String
  label      String
  type       String   @default("text")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

// OAuth 2.1 pour le connecteur MCP (Claude, Cursor…) : applications enregistrées dynamiquement.
model McpClient {
  id           String          @id
  name         String
  redirectUris String
  secretHash   String?
  codes        McpAuthCode[]
  connections  McpConnection[]
  createdAt    DateTime        @default(now())
}

model McpAuthCode {
  codeHash      String    @id
  clientId      String
  client        McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String
  scope         String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model McpConnection {
  id               String    @id @default(cuid())
  clientId         String
  client           McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope            String?
  accessTokenHash  String    @unique
  accessExpiresAt  DateTime
  refreshTokenHash String    @unique
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

model PasswordResetToken {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Webhooks entrants (ex. MeetMagnet) : URL secrète + réglages, et journal des réceptions.
model InboundWebhook {
  id              String   @id @default(cuid())
  source          String   @unique
  token           String   @unique
  defaultCategory String   @default("lead")
  defaultState    String   @default("new_lead")
  createTask      Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  source     String
  event      String
  externalId String?
  status     String
  summary    String
  contactId  String?
  receivedAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([receivedAt])
}
